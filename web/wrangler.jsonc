{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cpu-physics-olympiad",
  "main": "worker/index.ts",
  "compatibility_date": "2026-05-01",
  "workers_dev": true,
  "vars": { "LEGACY_PRIMARY_USERNAME": "course-admin", "CLASSROOM_ORIGIN": "https://cpu-physics-olympiad.ngantszhang1008-mc.workers.dev" },
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "COURSES", "class_name": "CourseStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CourseStore"] }]
}
